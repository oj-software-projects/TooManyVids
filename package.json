{
  "name": "toomanyvids",
  "version": "0.1.2",
  "description": "Single-window multi-video player with configurable grid layout",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dev": "electron . --dev",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "video",
    "player",
    "grid",
    "multi-video",
    "electron"
  ],
  "author": "TooManyVids",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "26.17.0",
    "electron-builder-squirrel-windows": "26.17.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.toomanyvids.app",
    "productName": "TooManyVids",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "category": "AudioVideo",
      "maintainer": "TooManyVids <maintainers@toomanyvids.invalid>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
